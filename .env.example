# --- App ---
BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# --- Postgres (consumed by docker-compose) ---
POSTGRES_USER=shortener
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shortener

# --- Postgres (consumed by the app) ---
# Host values, for running uvicorn locally. docker-compose overrides these
# with the service hostnames db / redis.
DATABASE_URL=postgresql+asyncpg://shortener:change-me@127.0.0.1:5432/shortener
TEST_DATABASE_URL=postgresql+asyncpg://shortener:change-me@127.0.0.1:5432/shortener_test

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_TTL_SECONDS=3600
NEGATIVE_CACHE_TTL_SECONDS=60

# --- Shortener ---
SHORT_ID_LENGTH=7
MAX_KEY_RETRIES=5
MAX_URL_LENGTH=2048
